
%%unf包 - 解压工具
unf:
  ver: 1.1
  int: ;一个简单的解压压缩包工具;
  au: ;FLT18355;
  per: +x
  lastupd: ;2026.6.21;
  type: ;cli;
  lang: ;python;
  repo: ;https://github.com/FLT18355/terminal;
  deps: ;python3, argparse;
  desc: |
    支持格式: tar.gz, tar.xz, zip, 7z, rar, zst, lz4, bz2, gz
    用法: unf --格式 文件名
    特色: 彩色输出, 自动检测格式, 支持密码
//

%%7zf包 - 7z 增强工具
7zf:
  ver: 1.4
  int: ;基于7zz的美化解压工具;
  au: ;FLT18355;
  per: +x
  lastupd: ;2026.6.21;
  type: ;cli;
  lang: ;python;
  repo: ;https://github.com/FLT18355/terminal;
  deps: ;python3, 7zz;
  desc: |
    基于 7zz 的增强解压工具
    支持: 压缩/解压, 密码保护, 分卷, 多线程
    用法: 7zf archive.7z -c ./folder -P 密码 -L 9
//

%%gits包 - Git 增强工具
gits:
  ver: 0.1
  int: ;Git 仓库管理增强工具;
  au: ;linxuan-sys;
  per: +x
  lastupd: ;2026.6.21;
  type: ;cli;
  lang: ;bash;
  repo: ;https://github.com/linxuan-sys/gits;
  deps: ;git, fzf, bat;
  desc: |
    交互式 Git 仓库管理工具
    支持: 批量克隆, 快速切换分支, 仓库状态查看
    用法: gits clone <url> | gits switch <repo> | gits status
//

%%========================================
%% 工具分类索引
%%========================================

categories:
  - name: ;解压工具;
    packages: ;unf, 7zf;
  - name: ;Git工具;
    packages: ;gits;
  - name: ;开发工具;
    packages: ;7zf, gits;

