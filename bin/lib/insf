#!/usr/bin/env python3
"""
insf - 简易 Pacman 包安装器
基于 Arch Linux 的 pacman 包管理器
"""

import os
import sys
import subprocess
import json
from pathlib import Path

class PacmanInstaller:
    def __init__(self):
        self.config_file = Path.home() / ".insf_config.json"
        self.load_config()
        self.install_history = []
    
    def load_config(self):
        """加载配置文件"""
        if self.config_file.exists():
            with open(self.config_file, 'r') as f:
                self.config = json.load(f)
        else:
            self.config = {
                "auto_confirm": False,
                "show_dependencies": True,
                "save_history": True
            }
            self.save_config()
    
    def save_config(self):
        """保存配置文件"""
        with open(self.config_file, 'w') as f:
            json.dump(self.config, f, indent=2)
    
    def check_root(self):
        """检查是否有root权限"""
        if os.geteuid() != 0:
            print("❌ insf 需要 root 权限才能运行！")
            print("请使用: sudo insf <包名>")
            sys.exit(1)
    
    def search_package(self, package_name):
        """搜索包"""
        print(f"\n🔍 insf 正在搜索包: {package_name}")
        print("="*50)
        
        try:
            result = subprocess.run(
                ["pacman", "-Ss", package_name],
                capture_output=True,
                text=True
            )
            
            if not result.stdout.strip():
                print(f"❌ 未找到包: {package_name}")
                return None
            
            # 解析搜索结果
            packages = []
            lines = result.stdout.strip().split('\n')
            for i in range(0, len(lines), 2):
                if i+1 < len(lines):
                    # 第一行: 包名和版本
                    pkg_line = lines[i].strip()
                    # 第二行: 描述
                    desc_line = lines[i+1].strip()
                    
                    if '/' in pkg_line:
                        repo, pkg_info = pkg_line.split('/', 1)
                        pkg_name, version = pkg_info.split(' ', 1)
                        packages.append({
                            "name": pkg_name,
                            "version": version,
                            "repo": repo,
                            "description": desc_line
                        })
            
            return packages
            
        except subprocess.CalledProcessError:
            print(f"❌ insf 搜索失败")
            return None
    
    def show_search_results(self, packages, query):
        """显示搜索结果"""
        if not packages:
            return
        
        print(f"\n📦 insf 找到 {len(packages)} 个匹配结果:")
        print("-"*70)
        
        for i, pkg in enumerate(packages[:10], 1):  # 最多显示10个
            print(f"{i}. {pkg['name']} {pkg['version']}")
            print(f"   仓库: {pkg['repo']}")
            print(f"   描述: {pkg['description']}")
            print()
        
        if len(packages) > 10:
            print(f"... 还有 {len(packages)-10} 个结果未显示")
    
    def get_package_info(self, package_name):
        """获取包详细信息"""
        try:
            result = subprocess.run(
                ["pacman", "-Si", package_name],
                capture_output=True,
                text=True
            )
            
            if result.returncode == 0:
                info = {}
                for line in result.stdout.strip().split('\n'):
                    if ':' in line:
                        key, value = line.split(':', 1)
                        info[key.strip()] = value.strip()
                return info
            return None
            
        except:
            return None
    
    def check_installed(self, package_name):
        """检查包是否已安装"""
        try:
            result = subprocess.run(
                ["pacman", "-Q", package_name],
                capture_output=True,
                text=True
            )
            return result.returncode == 0
        except:
            return False
    
    def get_dependencies(self, package_name):
        """获取依赖列表"""
        try:
            result = subprocess.run(
                ["pacman", "-Si", package_name],
                capture_output=True,
                text=True
            )
            
            if result.returncode == 0:
                for line in result.stdout.strip().split('\n'):
                    if '依赖' in line or 'Depends' in line:
                        deps = line.split(':', 1)[1].strip()
                        if deps and deps != '无':
                            return [d.strip() for d in deps.split() if not d.startswith('>')]
            return []
        except:
            return []
    
    def install_package(self, package_name, options=None):
        """安装包"""
        if options is None:
            options = {}
        
        # 检查是否已安装
        if self.check_installed(package_name):
            print(f"⚠️  {package_name} 已安装")
            choice = input("是否重新安装？[y/N]: ").strip().lower()
            if choice != 'y':
                return False
        
        # 获取包信息
        pkg_info = self.get_package_info(package_name)
        if pkg_info:
            print(f"\n📦 insf 准备安装: {package_name}")
            print("="*50)
            print(f"版本: {pkg_info.get('版本', '未知')}")
            print(f"描述: {pkg_info.get('描述', '无')}")
            print(f"大小: {pkg_info.get('安装大小', '未知')}")
            
            # 显示依赖
            if self.config.get("show_dependencies", True):
                deps = self.get_dependencies(package_name)
                if deps:
                    print(f"依赖: {', '.join(deps)}")
        
        # 确认安装
        if not self.config.get("auto_confirm", False):
            print("\n是否继续安装？")
            print("  [Y] 是 - insf 执行安装")
            print("  [n] 否 - 取消安装")
            print("  [d] 查看 - 详细依赖信息")
            
            while True:
                choice = input("\n请选择 [Y/n/d]: ").strip().lower()
                
                if choice == 'y' or choice == '':
                    break
                elif choice == 'n':
                    print("❌ insf 安装已取消")
                    return False
                elif choice == 'd':
                    self.show_dependency_tree(package_name)
                    continue
                else:
                    print("⚠️  无效选择，请输入 Y、n 或 d")
        
        # 执行安装
        return self.do_install(package_name, options)
    
    def do_install(self, package_name, options):
        """执行实际安装"""
        print(f"\n⏳ insf 正在安装 {package_name}...")
        print("="*50)
        
        try:
            # 构建安装命令
            cmd = ["pacman", "-S"]
            
            if options.get("no_confirm", False) or self.config.get("auto_confirm", False):
                cmd.append("--noconfirm")
            
            if options.get("as_dep", False):
                cmd.append("--asdeps")
            
            cmd.append(package_name)
            
            # 执行安装
            process = subprocess.Popen(
                cmd,
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                text=True,
                bufsize=1
            )
            
            # 实时显示输出
            for line in process.stdout:
                print(line, end='')
            
            process.wait()
            
            if process.returncode == 0:
                print(f"\n✅ insf {package_name} 安装成功！")
                self.save_install_history(package_name)
                return True
            else:
                print(f"\n❌ insf 安装失败，错误代码: {process.returncode}")
                return False
                
        except Exception as e:
            print(f"\n❌ insf 安装过程出错: {e}")
            return False
    
    def show_dependency_tree(self, package_name):
        """显示依赖树"""
        print(f"\n🌳 {package_name} 的依赖关系:")
        print("-"*50)
        
        try:
            result = subprocess.run(
                ["pacman", "-Si", package_name],
                capture_output=True,
                text=True
            )
            
            if result.returncode == 0:
                deps_found = False
                for line in result.stdout.strip().split('\n'):
                    if '依赖' in line or 'Depends' in line:
                        deps = line.split(':', 1)[1].strip()
                        if deps and deps != '无':
                            deps_found = True
                            dep_list = [d.strip() for d in deps.split() if not d.startswith('>')]
                            for dep in dep_list:
                                print(f"  ├─ {dep}")
                                # 显示子依赖（一级）
                                sub_deps = self.get_dependencies(dep)
                                if sub_deps:
                                    for sub_dep in sub_deps[:3]:  # 限制显示层级
                                        print(f"  │  ├─ {sub_dep}")
                                    if len(sub_deps) > 3:
                                        print(f"  │  └─ ... 还有 {len(sub_deps)-3} 个")
                        else:
                            print("  └─ 无依赖")
                if not deps_found:
                    print("  └─ 无依赖")
        except:
            print("  └─ 无法获取依赖信息")
    
    def save_install_history(self, package_name):
        """保存安装历史"""
        if self.config.get("save_history", True):
            history_file = Path.home() / ".insf_history.json"
            
            if history_file.exists():
                with open(history_file, 'r') as f:
                    history = json.load(f)
            else:
                history = []
            
            history.append({
                "package": package_name,
                "timestamp": str(subprocess.check_output(["date"]).decode().strip())
            })
            
            with open(history_file, 'w') as f:
                json.dump(history, f, indent=2)
    
    def show_history(self):
        """显示安装历史"""
        history_file = Path.home() / ".insf_history.json"
        
        if not history_file.exists():
            print("📋 insf 没有安装历史记录")
            return
        
        with open(history_file, 'r') as f:
            history = json.load(f)
        
        print(f"\n📋 insf 安装历史 ({len(history)} 条记录):")
        print("-"*60)
        
        for i, entry in enumerate(history[-10:], 1):
            print(f"{i}. {entry['package']} - {entry['timestamp']}")
        
        if len(history) > 10:
            print(f"... 还有 {len(history)-10} 条历史记录")
    
    def multiple_install(self, packages):
        """批量安装"""
        print(f"\n📦 insf 准备批量安装 {len(packages)} 个包")
        print("="*50)
        
        for pkg in packages:
            print(f"\n🔹 安装: {pkg}")
            self.install_package(pkg, {"no_confirm": True})
            print("-"*50)
    
    def run(self, args):
        """主运行函数"""
        print("\n" + "="*50)
        print("🎯 insf - Pacman 简易包安装器")
        print("="*50)
        
        # 检查权限
        self.check_root()
        
        if not args:
            print("用法: insf <包名> [包名2 包名3 ...]")
            print("选项:")
            print("  -s, --search <关键词>  搜索包")
            print("  -h, --history          查看安装历史")
            print("  -i, --info <包名>      显示包信息")
            print("  -y, --yes              自动确认安装")
            print("\n示例:")
            print("  insf vim               # 安装单个包")
            print("  insf vim git curl      # 批量安装")
            print("  insf -s python         # 搜索包")
            print("  insf -i vim            # 查看包信息")
            return
        
        # 处理选项
        if args[0] in ['-s', '--search']:
            if len(args) < 2:
                print("❌ 请指定搜索关键词")
                return
            packages = self.search_package(args[1])
            if packages:
                self.show_search_results(packages, args[1])
            return
        
        elif args[0] in ['-h', '--history']:
            self.show_history()
            return
        
        elif args[0] in ['-i', '--info']:
            if len(args) < 2:
                print("❌ 请指定包名")
                return
            info = self.get_package_info(args[1])
            if info:
                print(f"\n📦 {args[1]} 包信息:")
                print("="*50)
                for key, value in info.items():
                    print(f"{key}: {value}")
            else:
                print(f"❌ 未找到包: {args[1]}")
            return
        
        elif args[0] in ['-y', '--yes']:
            self.config["auto_confirm"] = True
            if len(args) < 2:
                print("❌ 请指定要安装的包名")
                return
            packages = args[1:]
        else:
            packages = args
        
        # 安装包
        if len(packages) == 1:
            self.install_package(packages[0])
        else:
            self.multiple_install(packages)

def main():
    try:
        installer = PacmanInstaller()
        installer.run(sys.argv[1:])
    except KeyboardInterrupt:
        print("\n\n⚠️  用户中断 insf 操作")
        sys.exit(0)
    except Exception as e:
        print(f"\n❌ insf 程序异常: {e}")
        sys.exit(1)

if __name__ == "__main__":
    main()