#!/usr/bin/env python3
"""
upf - 简易 Pacman 包更新器
基于 Arch Linux 的 pacman 包管理器
"""

import os
import sys
import subprocess
import json
import re
from pathlib import Path

class PacmanUpdater:
    def __init__(self):
        self.config_file = Path.home() / ".upf_config.json"
        self.load_config()
    
    def load_config(self):
        """加载配置文件"""
        if self.config_file.exists():
            with open(self.config_file, 'r') as f:
                self.config = json.load(f)
        else:
            self.config = {
                "check_update_on_start": True,
                "auto_clean_cache": False
            }
            self.save_config()
    
    def save_config(self):
        """保存配置文件"""
        with open(self.config_file, 'w') as f:
            json.dump(self.config, f, indent=2)
    
    def check_root(self):
        """检查是否有root权限"""
        if os.geteuid() != 0:
            print("❌ upf 需要 root 权限才能运行！")
            print("请使用: sudo upf")
            sys.exit(1)
    
    def check_updates(self):
        """检查可用更新"""
        print("\n" + "="*50)
        print("🔍 upf 正在检查更新...")
        print("="*50)
        
        try:
            # 刷新包数据库
            print("📦 刷新包数据库...")
            subprocess.run(["pacman", "-Sy"], check=True, capture_output=True)
            
            # 检查可更新包
            result = subprocess.run(
                ["pacman", "-Qu"], 
                capture_output=True, 
                text=True
            )
            
            if not result.stdout.strip():
                print("\n✅ 所有包已经是最新版本！")
                return []
            
            # 解析更新列表 - 改进版本解析
            updates = []
            for line in result.stdout.strip().split('\n'):
                if line:
                    # 使用正则表达式解析
                    # 格式: "package old_version -> new_version"
                    match = re.match(r'(\S+)\s+(\S+)\s+->\s+(\S+)', line)
                    if match:
                        updates.append({
                            "name": match.group(1),
                            "old_version": match.group(2),
                            "new_version": match.group(3)
                        })
                    else:
                        # 备用解析
                        parts = line.split()
                        if len(parts) >= 3:
                            updates.append({
                                "name": parts[0],
                                "old_version": parts[1],
                                "new_version": parts[3] if len(parts) > 3 else "未知"
                            })
            
            return updates
            
        except subprocess.CalledProcessError as e:
            print(f"❌ upf 检查更新失败: {e}")
            return None
    
    def show_updates(self, updates):
        """显示更新列表"""
        if not updates:
            return
        
        print(f"\n📋 upf 发现 {len(updates)} 个可用更新：")
        print("-"*70)
        print(f"{'包名':<35} {'当前版本':<20} {'新版本':<15}")
        print("-"*70)
        
        for pkg in updates:
            print(f"{pkg['name']:<35} {pkg['old_version']:<20} {pkg['new_version']:<15}")
        print("-"*70)
    
    def perform_update(self, updates):
        """执行更新"""
        if not updates:
            return
        
        print("\n" + "="*50)
        print("🚀 upf 准备更新...")
        print("="*50)
        
        # 显示更新摘要
        total_size = self.get_update_size()
        
        print(f"\nupf 将要更新 {len(updates)} 个包")
        if total_size:
            print(f"总下载大小: {total_size}")
        
        # 用户确认
        print("\n是否继续更新？")
        print("  [Y] 是 - upf 执行更新")
        print("  [n] 否 - 取消更新")
        print("  [v] 查看 - 显示详细包信息")
        
        while True:
            choice = input("\n请选择 [Y/n/v]: ").strip().lower()
            
            if choice == 'y' or choice == '':
                self.do_update()
                break
            elif choice == 'n':
                print("❌ upf 更新已取消")
                break
            elif choice == 'v':
                self.show_package_details(updates)
                # 重新显示菜单
                print("\n是否继续更新？")
                print("  [Y] 是 - upf 执行更新")
                print("  [n] 否 - 取消更新")
                continue
            else:
                print("⚠️  无效选择，请输入 Y、n 或 v")
    
    def get_update_size(self):
        """获取更新大小"""
        try:
            result = subprocess.run(
                ["pacman", "-Syu", "--print-format=%S"],
                capture_output=True,
                text=True
            )
            if result.stdout.strip():
                size_bytes = sum(int(s) for s in result.stdout.strip().split() if s.isdigit())
                if size_bytes > 1024*1024*1024:
                    return f"{size_bytes/(1024**3):.2f} GB"
                elif size_bytes > 1024*1024:
                    return f"{size_bytes/(1024**2):.2f} MB"
                else:
                    return f"{size_bytes/1024:.2f} KB"
        except:
            pass
        return None
    
    def do_update(self):
        """执行实际更新"""
        print("\n⏳ upf 正在更新系统...")
        print("="*50)
        
        try:
            # 使用 pacman 的 --noconfirm 自动确认所有问题
            # 使用 -Syu 而不是 -Syu --noconfirm，让 pacman 自己处理确认
            cmd = ["pacman", "-Syu", "--noconfirm"]
            
            # 执行更新，不需要手动输入确认
            process = subprocess.Popen(
                cmd,
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                text=True,
                bufsize=1,
                stdin=subprocess.DEVNULL  # 禁用标准输入，防止等待用户输入
            )
            
            # 实时显示输出
            for line in process.stdout:
                print(line, end='')
            
            process.wait()
            
            if process.returncode == 0:
                print("\n✅ upf 系统更新完成！")
                self.clean_cache()
            else:
                print(f"\n❌ upf 更新失败，错误代码: {process.returncode}")
                
        except Exception as e:
            print(f"\n❌ upf 更新过程出错: {e}")
    
    def clean_cache(self):
        """清理缓存（可选）"""
        if self.config.get("auto_clean_cache", False):
            print("\n🧹 upf 正在清理缓存...")
            try:
                subprocess.run(["pacman", "-Sc", "--noconfirm"], 
                             capture_output=True)
                print("✅ upf 缓存清理完成")
            except:
                pass
    
    def show_package_details(self, updates):
        """显示包详细信息"""
        print("\n📦 upf 包详细信息:")
        print("-"*70)
        
        for pkg in updates[:5]:  # 最多显示5个
            try:
                result = subprocess.run(
                    ["pacman", "-Qi", pkg['name']],
                    capture_output=True,
                    text=True
                )
                if result.returncode == 0:
                    info_lines = result.stdout.strip().split('\n')
                    print(f"\n🔹 {pkg['name']}")
                    print(f"   当前版本: {pkg['old_version']}")
                    print(f"   新版本: {pkg['new_version']}")
                    # 显示额外信息
                    for line in info_lines[:10]:
                        if ':' in line and not any(x in line for x in ['名称', 'Name', '版本', 'Version']):
                            key, value = line.split(':', 1)
                            print(f"   {key.strip()}: {value.strip()}")
                else:
                    print(f"\n🔹 {pkg['name']}")
                    print(f"   当前版本: {pkg['old_version']}")
                    print(f"   新版本: {pkg['new_version']}")
            except:
                print(f"\n🔹 {pkg['name']}")
                print(f"   当前版本: {pkg['old_version']}")
                print(f"   新版本: {pkg['new_version']}")
    
    def run(self):
        """主运行函数"""
        print("\n" + "="*50)
        print("🎯 upf - Pacman 简易包更新器")
        print("="*50)
        
        # 检查权限
        self.check_root()
        
        # 检查更新
        updates = self.check_updates()
        
        if updates is None:
            return
        
        # 显示更新列表
        self.show_updates(updates)
        
        # 如果有更新，询问是否执行
        if updates:
            self.perform_update(updates)
        else:
            print("\n💡 系统已是最新状态")
        
        print("\n" + "="*50)
        print("👋 upf 运行完成")
        print("="*50)

def main():
    try:
        updater = PacmanUpdater()
        updater.run()
    except KeyboardInterrupt:
        print("\n\n⚠️  用户中断 upf 操作")
        sys.exit(0)
    except Exception as e:
        print(f"\n❌ upf 程序异常: {e}")
        sys.exit(1)

if __name__ == "__main__":
    main()