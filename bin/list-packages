#!/usr/bin/env python3
"""
list-packages - 列出 Arch Linux 已安装的包，输出为 JSON 格式 (快速版)
用法: list-packages [选项]
"""

import json
import subprocess
import argparse
import sys
from datetime import datetime

def get_all_packages_info() -> dict:
    """一次性获取所有包的信息（使用 pacman -Qii）"""
    try:
        # 一次性获取所有包的详细信息
        result = subprocess.run(
            ["pacman", "-Qii"],
            capture_output=True,
            text=True,
            check=True
        )
        
        packages = []
        current_pkg = {}
        
        for line in result.stdout.split('\n'):
            if not line.strip():
                # 空行表示一个包的结束
                if current_pkg:
                    # 整理依赖
                    if 'dependencies' in current_pkg:
                        deps = []
                        if current_pkg['dependencies'] and current_pkg['dependencies'] != 'None':
                            for dep in current_pkg['dependencies'].split(' '):
                                if dep and not dep.startswith('('):
                                    clean_dep = dep.split('>')[0].split('<')[0].split('=')[0]
                                    deps.append(clean_dep)
                        current_pkg['dependencies'] = deps
                    
                    # 整理 required_by
                    if 'required_by' in current_pkg:
                        reqs = []
                        if current_pkg['required_by'] and current_pkg['required_by'] != 'None':
                            reqs = [r.strip() for r in current_pkg['required_by'].split(' ') if r.strip()]
                        current_pkg['required_by'] = reqs
                    
                    # 检测来源
                    current_pkg['source'] = detect_package_source(current_pkg.get('name', ''))
                    
                    packages.append(current_pkg)
                    current_pkg = {}
                continue
            
            # 解析行
            if ': ' in line:
                key, value = line.split(': ', 1)
                key = key.strip()
                value = value.strip()
                current_pkg[key] = value
        
        # 处理最后一个包
        if current_pkg:
            if 'dependencies' in current_pkg:
                deps = []
                if current_pkg['dependencies'] and current_pkg['dependencies'] != 'None':
                    for dep in current_pkg['dependencies'].split(' '):
                        if dep and not dep.startswith('('):
                            clean_dep = dep.split('>')[0].split('<')[0].split('=')[0]
                            deps.append(clean_dep)
                current_pkg['dependencies'] = deps
            
            if 'required_by' in current_pkg:
                reqs = []
                if current_pkg['required_by'] and current_pkg['required_by'] != 'None':
                    reqs = [r.strip() for r in current_pkg['required_by'].split(' ') if r.strip()]
                current_pkg['required_by'] = reqs
            
            current_pkg['source'] = detect_package_source(current_pkg.get('name', ''))
            packages.append(current_pkg)
        
        return {
            'packages': packages,
            'total': len(packages)
        }
        
    except subprocess.CalledProcessError as e:
        print(f"错误: pacman -Qii 执行失败: {e}", file=sys.stderr)
        sys.exit(1)

def detect_package_source(pkg_name: str) -> str:
    """快速检测包的来源"""
    if not pkg_name:
        return 'unknown'
    
    # 检查是否在官方仓库中
    try:
        result = subprocess.run(
            ["pacman", "-Si", pkg_name],
            capture_output=True,
            text=True,
            timeout=2
        )
        if result.returncode == 0:
            return 'official-repo'
    except:
        pass
    
    # 检查是否已安装 yay/paru 且包在 AUR 中
    for helper in ['yay', 'paru']:
        try:
            result = subprocess.run(
                [helper, "-Si", pkg_name],
                capture_output=True,
                text=True,
                timeout=2
            )
            if result.returncode == 0 and 'AUR' in result.stdout:
                return 'aur'
        except:
            pass
    
    return 'unknown'

def list_packages(explicit_only: bool = False, output_file: str = None):
    """列出所有已安装的包"""
    print("正在获取包信息...", file=sys.stderr)
    
    # 如果只显式安装，先用 pacman -Qe 获取列表
    if explicit_only:
        try:
            result = subprocess.run(
                ["pacman", "-Qe"],
                capture_output=True,
                text=True,
                check=True
            )
            explicit_names = set()
            for line in result.stdout.strip().split('\n'):
                if line:
                    parts = line.split(' ', 1)
                    if len(parts) >= 1:
                        explicit_names.add(parts[0])
        except:
            explicit_names = set()
    
    # 一次性获取所有包信息
    data = get_all_packages_info()
    packages = data['packages']
    
    # 如果是显式安装模式，过滤
    if explicit_only:
        filtered = [p for p in packages if p.get('Name', '') in explicit_names]
        packages = filtered
        total = len(filtered)
        print(f"✅ 显式安装的包: {total} 个", file=sys.stderr)
    else:
        total = data['total']
        print(f"✅ 共获取: {total} 个包", file=sys.stderr)
    
    # 统计来源
    stats = {'official-repo': 0, 'aur': 0, 'unknown': 0}
    packages_by_source = {'official-repo': [], 'aur': [], 'unknown': []}
    
    for pkg in packages:
        source = pkg.get('source', 'unknown')
        if source in stats:
            stats[source] += 1
            packages_by_source[source].append(pkg.get('Name', ''))
        else:
            stats['unknown'] += 1
            packages_by_source['unknown'].append(pkg.get('Name', ''))
    
    # 计算总大小
    total_size = 0
    for pkg in packages:
        size_str = pkg.get('Installed Size', '0 KiB')
        try:
            if 'MiB' in size_str:
                total_size += float(size_str.replace(' MiB', ''))
            elif 'KiB' in size_str:
                total_size += float(size_str.replace(' KiB', '')) / 1024
        except:
            pass
    
    # 构建输出
    output = {
        'metadata': {
            'total_packages': total,
            'explicit_only': explicit_only,
            'total_size_mib': round(total_size, 2),
            'generated_at': datetime.now().isoformat(),
            'system': 'Arch Linux',
            'source_stats': stats,
            'packages_by_source': packages_by_source
        },
        'packages': packages
    }
    
    json_output = json.dumps(output, indent=2, ensure_ascii=False)
    
    if output_file:
        with open(output_file, 'w', encoding='utf-8') as f:
            f.write(json_output)
        print(f"✅ 已保存到: {output_file}", file=sys.stderr)
        print(f"📊 总包数: {total}", file=sys.stderr)
        print(f"📦 官方仓库: {stats['official-repo']}", file=sys.stderr)
        print(f"📦 AUR: {stats['aur']}", file=sys.stderr)
        print(f"💾 总大小: {round(total_size, 2)} MiB", file=sys.stderr)
    else:
        print(json_output)

def main():
    parser = argparse.ArgumentParser(
        description="列出 Arch Linux 已安装的包，输出为 JSON 格式 (快速版)"
    )
    parser.add_argument(
        "-e", "--explicit",
        action="store_true",
        help="只列出显式安装的包（非依赖）"
    )
    parser.add_argument(
        "-o", "--output",
        help="输出到文件 (默认: 输出到终端)"
    )
    
    args = parser.parse_args()
    list_packages(args.explicit, args.output)

if __name__ == "__main__":
    main()