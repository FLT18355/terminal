[global]
    ### 位置与几何
    monitor = 0
    follow = keyboard
    geometry = "300x80-10+30"
    origin = top-right
    offset = 10x30
    width = 125
    height = 35
    padding = 8
    horizontal_padding = 12
    frame_width = 2
    frame_color = "#89b4fa"
    corner_radius = 8
    transparency = 10

    ### 字体与文本
    font = "Noto Sans CJK SC 5"
    line_height = 0
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    word_wrap = yes
    ellipsize = middle
    ignore_newline = no

    ### 行为
    timeout = 6
    idle_threshold = 120
    sort = yes
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = true
    indicate_hidden = yes
    shrink = yes
    sticky_history = yes
    history_length = 30
    show_age_threshold = 60

    ### 图标
    icon_position = left
    max_icon_size = 32
    icon_theme = Papirus
    enable_recursive_icon_lookup = true

    ### 快捷键
    close = ctrl+space
    close_all = ctrl+shift+space
    history = ctrl+grave
    context = ctrl+shift+period

### 三种紧急级别配色
[urgency_low]
    background = "#313244"
    foreground = "#cdd6f4"
    frame_color = "#89b4fa"
    timeout = 5

[urgency_normal]
    background = "#45475a"
    foreground = "#cdd6f4"
    frame_color = "#cba6f7"
    timeout = 8

[urgency_critical]
    background = "#f38ba8"
    foreground = "#1e1e2e"
    frame_color = "#f38ba8"
    timeout = 0

### 规则示例：音量/亮度通知（带进度条）
[volume]
    appname = "changeVolume"
    summary = "Volume*"
    background = "#313244"
    foreground = "#cdd6f4"
    frame_color = "#89b4fa"
    timeout = 2
    history_ignore = yes

[brightness]
    summary = "Brightness*"
    background = "#313244"
    foreground = "#cdd6f4"
    frame_color = "#f9e2af"
    timeout = 2
    history_ignore = yes

### 规则示例：静默某些应用
[spotify]
    appname = "Spotify"
    urgency = low
    timeout = 3