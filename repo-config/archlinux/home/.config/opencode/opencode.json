{
    "$schema": "https://opencode.ai/config.json",
    "provider": {
        "agnes": {
            "npm": "@ai-sdk/openai-compatible",
            "name": "Agnes",
            "options": {
                "baseURL": "https://apihub.agnes-ai.com/v1",
                "apiKey": "？？？"
            },
            "models": {
                "agnes-2.5-flash": {
                    "name": "猫娘2.5",
                    "limit": {
                        "context": 512000,
                        "output": 65536
                    },
                    "variants": {
                        "fast": {
                            "reasoningEffort": "low"
                        },
                        "medium": {
                            "reasoningEffort": "medium"
                        },
                        "deep": {
                            "reasoningEffort": "high"
                        },
                        "minimal": {
                            "reasoningEffort": "none"
                        }
                    }
                },
                "agnes-image-2.1-flash": {
                    "name": "图片模型(放着玩的)"
                }
            }
        },
        "sensenova": {
            "npm": "@ai-sdk/openai-compatible",
            "name": "SenseNova",
            "options": {
                "baseURL": "https://token.sensenova.cn/v1",
                "apiKey": "？？？",
                "queryParams": {
                    "remove": [
                        "response_format",
                        "tool_choice"
                    ]
                }
            },
            "models": {
                "sensenova-6.7-flash-lite": {
                    "name": "SenseNova 6.7 Flash Lite",
                    "limit": {
                        "context": 256000,
                        "output": 64000
                    }
                },
                "deepseek-v4-flash": {
                    "name": "DeepSeek V4 Flash"
                }
            }
        },
        "modelscope": {
            "npm": "@ai-sdk/openai-compatible",
            "name": "ModelScope",
            "options": {
                "baseURL": "https://api-inference.modelscope.cn/v1",
                "apiKey": "？？？"
            },
            "models": {
                "ZhipuAI/GLM-4.7-Flash": {
                    "name": "GLM 4.7 Flash",
                    "limit": {
                        "context": 32768,
                        "output": 8192
                    }
                },
                "Qwen/Qwen3-Coder-480B-A35B-Instruct": {
                    "name": "Qwen3 Coder 480B",
                    "limit": {
                        "context": 32768,
                        "output": 8192
                    }
                }
            }
        },
        "nvidia-nim": {
            "npm": "@ai-sdk/openai-compatible",
            "name": "NVIDIA NIM",
            "options": {
                "baseURL": "https://integrate.api.nvidia.com/v1",
                "apiKey": "？？？"
            },
            "models": {
                "z-ai/glm-5.2": {
                    "name": "GLM 5.2",
                    "limit": {
                        "context": 32768,
                        "output": 4096
                    }
                },
                "thinkingmachines/inkling": {
                    "name": "Inkling",
                    "limit": {
                        "context": 256000,
                        "output": 32768
                    }
                },
                "minimaxai/minimax-m3": {
                    "name": "MiniMax M3",
                    "limit": {
                        "context": 1000000,
                        "output": 65536
                    }
                }
            }
        }
    },
    "mcp": {
        "image-mcp": {
            "type": "local",
            "command": [
                "npx",
                "--registry",
                "https://registry.npmjs.org",
                "@shadowdqj/image-mcp"
            ]
        }
    },
    "plugin": [
        "openkilo",
        "opencode-personality",
        "@neomei/agentsoul"
    ]
}